# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}
# Keep class names and packages: renaming moved package-private Kotlin classes and broke start-up.
-dontobfuscate

# The Pleos Vehicle SDK reads @Deprecated on its own methods by reflection. R8 had stripped
# kotlin.Deprecated's members, so every capability check failed ("missing element replaceWith")
# and the app showed no car signals. Keep annotation types and their members.
-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod,RuntimeVisibleAnnotations
-keep @interface kotlin.** { *; }
-keep class kotlin.ReplaceWith { *; }
-keep enum kotlin.DeprecationLevel { *; }
-keep enum kotlin.annotation.** { *; }
