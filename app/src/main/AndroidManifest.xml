  <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
  <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
  <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
  <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
  <application android:allowBackup="false" android:dataExtractionRules="@xml/private_data_rules" android:networkSecurityConfig="@xml/network_security_config" android:icon="@mipmap/ic_launcher" android:label="@string/app_name" android:roundIcon="@mipmap/ic_launcher_round" android:supportsRtl="true" android:theme="@style/Theme.WashGuard">
    <uses-library android:name="android.car" android:required="false" />
    <!-- Keeps the Pit Wall (car readings, Box call radio) running while the app is behind the navi. -->
    <service android:name=".PitWallService" android:exported="false" android:foregroundServiceType="specialUse|microphone">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="In-car pit wall: watches battery, route and warning lights while driving and speaks short radio calls." />
    </service>
    <activity android:name=".MainActivity" android:exported="true" android:label="@string/app_name" android:theme="@style/Theme.WashGuard" android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- The app has its own driving layout (DriveScreen, Box call banner with two large buttons),
           so it stays on screen while driving instead of the system blocking screen. -->
      <meta-data android:name="distractionOptimized" android:value="true" />
    </activity>
  </application>
</manifest>
