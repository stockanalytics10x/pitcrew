  <queries><package android:name="ai.pleos.playground.service.navi" /><package android:name="ai.pleos.playground.service.location.fused" /><package android:name="ai.pleos.playground.caas" /><intent><action android:name="android.intent.action.TTS_SERVICE" /></intent></queries>
  <uses-permission android:name="android.car.permission.CAR_ENERGY" />
  <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
  <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
  <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
